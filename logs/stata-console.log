. do "code/04_figures.do" // Draw all four figures from those estimates and bin means.

. * Inputs: estimated scalars and bin datasets. Outputs: four vector PDF figures.
. version 19.0 // Use Stata 19's graph syntax and defaults.

. foreach sample in individual pooled { // Draw a choice plot and a time plot for each sample.
  2.     if "`sample'" == "individual" { // Set the individual graph's parameter names and horizontal range.
  3.         local suffix i // Read the individual estimates, whose scalar names end in _i.
  4.         local bound = scalar(delta_max) // Plot the individual curve from -M to M, matching the bin range.
  5.         local tick "-4(2)4" // Label the individual horizontal axis every two dollars from -4 to 4.
  6.     } // Finish the individual graph settings.
  7.     else { // Use the following settings for the pooled class plots.
  8.         local suffix c // Read the class estimates, whose scalar names end in _c.
  9.         local bound = 10 // Use a symmetric range covering all supplied class differences.
 10.         local tick "-10(2)10" // Label the class horizontal axis every two dollars from -10 to 10.
 11.     } // Finish selecting settings for this sample.
 12.     use "${PROCESSED}/`sample'-bins.dta", clear // Load the sample's observed and predicted bin means.
 13.     local alpha = scalar(alpha_`suffix') // Copy fitted choice sensitivity into a local macro for the curve expression.
 14.     local scale = scalar(A_`suffix') // Copy the fitted time scale for the response-time curve.
 15.     local offset = scalar(t0_`suffix') // Copy the fitted nondecision time for the response-time curve.
 16.     twoway /// Combine the theoretical choice curve with two sets of bin points.
>         (function y=invlogit(2*`alpha'*x), range(-`bound' `bound') n(1001) lcolor(black) lwidth(medthin)) /// Draw P(d) at 1,001 evenly spaced points as a thin black curve.
>         (scatter ej dj, msymbol(O) msize(small) mcolor(black)) /// Use small filled circles for the model's mean choice predictions.
>         (scatter pj dj, msymbol(Oh) msize(medlarge) mcolor(black) mlwidth(medthin)), /// Use larger open circles for observed right-choice shares so overlaps remain visible.
>         xtitle("Value difference, right minus left ($)", margin(t=3)) /// Label the bid difference in dollars; the top margin keeps the title clear of the tick labels in Latin
>  Modern.
>         ytitle("Frequency of choosing right") /// Label the vertical axis as a right-choice frequency.
>         xlabel(`tick', labsize(small) nogrid) ylabel(0(.2)1, labsize(small) angle(horizontal) nogrid) /// Show the selected dollar ticks and frequencies from zero to one, with
> out grid lines.
